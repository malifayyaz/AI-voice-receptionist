# Server Configuration
PORT=3000

# LLM Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# Service Account Email (e.g. your-bot@project.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Service Account Private Key (keep the quotes if using \n in the key)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
